{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth.js?action=$1" },
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/users/(.*)", "destination": "/api/auth.js?action=users/$1" },
    { "source": "/api/users", "destination": "/api/auth.js?action=users" },
    { "source": "/api/audit-logs/(.*)", "destination": "/api/auth.js?action=audit-logs/$1" },
    { "source": "/api/audit-logs", "destination": "/api/auth.js?action=audit-logs" },
    { "source": "/api/equipment", "destination": "/api/equipment.js" },
    { "source": "/api/sync", "destination": "/api/sync.js" },
    { "source": "/api/lightning", "destination": "/api/lightning.js" },
    { "source": "/api/novara", "destination": "/api/novara.js" },
    { "source": "/assets/(.*)", "destination": "/html/assets/$1" },
    { "source": "/css/(.*)", "destination": "/html/css/$1" },
    { "source": "/js/(.*)", "destination": "/html/js/$1" },
    { "source": "/login.html", "destination": "/html/login.html" },
    { "source": "/register.html", "destination": "/html/register.html" },
    { "source": "/mobile.html", "destination": "/html/mobile.html" },
    { "source": "/desktop.html", "destination": "/html/desktop.html" },
    { "source": "/version.txt", "destination": "/html/assets/data/version.txt" },
    { "source": "/", "destination": "/html/index.html" }
  ]
}
